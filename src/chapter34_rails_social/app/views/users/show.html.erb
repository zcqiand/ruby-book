<!-- 用户个人页面 -->
<div class="user-profile">
  <header class="profile-header">
    <div class="avatar-large">
      <%= image_tag @user.avatar_url, alt: @user.username if @user.avatar_url %>
    </div>

    <div class="profile-info">
      <h1><%= @user.username %></h1>
      <p class="bio"><%= @user.bio %></p>

      <div class="stats-row">
        <div class="stat">
          <strong><%= @user.posts.count %></strong>
          <span>帖子</span>
        </div>
        <div class="stat clickable" data-href="<%= followers_user_path(@user) %>">
          <strong><%= @user.followers_count %></strong>
          <span>粉丝</span>
        </div>
        <div class="stat clickable" data-href="<%= following_user_path(@user) %>">
          <strong><%= @user.following_count %></strong>
          <span>关注</span>
        </div>
      </div>
    </div>

    <div class="profile-actions">
      <% if current_user && current_user != @user %>
        <% if current_user.following?(@user) %>
          <%= button_to '取消关注',
                        user_follow_path(@user),
                        method: :delete,
                        class: 'btn btn-large',
                        id: 'follow-btn' %>
        <% else %>
          <%= button_to '关注',
                        user_follow_path(@user),
                        method: :post,
                        class: 'btn btn-primary btn-large',
                        id: 'follow-btn' %>
        <% end %>
      <% elsif current_user == @user %>
        <%= link_to '编辑资料', edit_user_registration_path, class: 'btn btn-outline' %>
      <% end %>
    </div>
  </header>

  <section class="user-posts">
    <h2>发布的帖子</h2>
    <%= render @user.posts %>
  </section>
</div>
