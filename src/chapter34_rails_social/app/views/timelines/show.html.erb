<!-- 时间线视图 -->
<!-- 展示用户关注的所有人的最新帖子 -->
<div class="timeline-page">
  <header class="timeline-header">
    <h1>我的时间线</h1>
    <p class="subtitle">来自你关注的用户的最新动态</p>
  </header>

  <% if @posts.any? %>
    <div class="posts-feed">
      <%= render partial: 'posts/post', collection: @posts, cached: true %>
    </div>

    <nav class="pagination-nav">
      <%= paginate @posts %>
    </nav>
  <% else %>
    <div class="empty-state">
      <p>时间线为空</p>
      <p>关注更多用户，发现精彩内容</p>
      <%= link_to '发现用户', users_path, class: 'btn btn-primary' %>
    </div>
  <% end %>
</div>
